# Optional LLM enhancement. The demo remains fully functional without this key:
# it uses a deterministic, evidence-grounded local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend runtime settings
DATABASE_URL=sqlite:///../data/patient360.db
CORS_ORIGINS=http://localhost:5173

# Frontend runtime setting (Vite exposes only variables prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000
